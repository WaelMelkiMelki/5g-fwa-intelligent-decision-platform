# Copy to app/.streamlit/secrets.toml and fill with your read-only PostgreSQL credentials.
# The app resolves credentials in this order:
#   1. Environment variables (FWA_DB_HOST, FWA_DB_PORT, FWA_DB_NAME, FWA_DB_USER, FWA_DB_PASSWORD)
#   2. Streamlit secrets [database] block below.
#
#   Use the LOWEST-privilege role available. The app enforces read-only at the
#   connection level (default_transaction_read_only=on) in addition to SELECT-only queries.

[database]
host = "localhost"
port = 5432
name = "postgres"
user = "YOUR_READ_ONLY_USER"
password = "YOUR_READ_ONLY_PASSWORD"
# Optional: point to the data schema (defaults to "cleaned_data")
# schema = "cleaned_data"
